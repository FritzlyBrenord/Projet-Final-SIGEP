"use client";

import React, { useState, useEffect, useMemo } from "react";
import {
  BarChart3,
  Users,
  GraduationCap,
  Building,
  TrendingUp,
  UserCheck,
  UserX,
  Award,
  Calendar,
  Clock,
  X,
  Download,
  Eye,
  Filter,
  ChevronDown,
  ChevronRight,
  BookOpen,
  DollarSign,
  FileText,
  Activity,
  History,
  Moon,
  Sun,
  Printer,
  Search,
  Star,
  CreditCard,
  CheckCircle,
  XCircle,
  AlertCircle,
  Trophy,
  Medal,
  Target,
} from "lucide-react";

interface Props {
  darkMode: boolean;
  // Simulated data for demonstration
  eleves?: any[];
  notes?: any[];
  classes?: any[];
  calculateMoyenneGeneraleTrimestre?: (
    eleveId: string,
    trimestre: 1 | 2 | 3
  ) => number;
  calculateMoyenneGeneraleAnnuelle?: (eleveId: string) => number;
  getStudentBalance?: (eleveId: string) => {
    totalDu: number;
    totalPaye: number;
    solde: number;
  };
}

const Rapport = ({
  darkMode,
  eleves = [],
  notes = [],
  classes = [],
  calculateMoyenneGeneraleTrimestre = () => Math.random() * 20,
  calculateMoyenneGeneraleAnnuelle = () => Math.random() * 20,
  getStudentBalance = () => ({ totalDu: 15000, totalPaye: 10000, solde: 5000 }),
}: Props) => {
  // États locaux
  const [activeSection, setActiveSection] = useState("eleves");
  const [selectedYear, setSelectedYear] = useState("2024-2025");
  const [filterClasse, setFilterClasse] = useState("toutes");
  const [filterDecision, setFilterDecision] = useState("tous");
  const [showFilters, setShowFilters] = useState(false);

  // Données simulées pour la démonstration
  const mockClasses = [
    { value: "9af", label: "9ème AF" },
    { value: "8af", label: "8ème AF" },
    { value: "7af", label: "7ème AF" },
    { value: "6af", label: "6ème AF" },
  ];

  const mockEleves = [
    {
      id: "1",
      prenom: "Marie",
      nom: "Dupont",
      classe_id: "9af",
      salle_id: "salle1",
      statut: "actif",
      moyenne_generale: 16.5,
    },
    {
      id: "2",
      prenom: "Pierre",
      nom: "Martin",
      classe_id: "9af",
      salle_id: "salle1",
      statut: "actif",
      moyenne_generale: 14.2,
    },
    {
      id: "3",
      prenom: "Sophie",
      nom: "Bernard",
      classe_id: "8af",
      salle_id: "salle2",
      statut: "actif",
      moyenne_generale: 18.1,
    },
    {
      id: "4",
      prenom: "Lucas",
      nom: "Moreau",
      classe_id: "8af",
      salle_id: "salle2",
      statut: "actif",
      moyenne_generale: 12.8,
    },
    {
      id: "5",
      prenom: "Emma",
      nom: "Leroy",
      classe_id: "7af",
      salle_id: "salle3",
      statut: "actif",
      moyenne_generale: 15.6,
    },
    {
      id: "6",
      prenom: "Thomas",
      nom: "Rousseau",
      classe_id: "6af",
      salle_id: "salle4",
      statut: "actif",
      moyenne_generale: 11.2,
    },
  ];

  const mockNotes = [
    {
      id: "1",
      eleve_id: "1",
      decision_de_fin_annee: "Admis",
      observation: "Excellent travail",
      trimestre: 3,
    },
    {
      id: "2",
      eleve_id: "2",
      decision_de_fin_annee: "Admis",
      observation: "Bon niveau",
      trimestre: 3,
    },
    {
      id: "3",
      eleve_id: "3",
      decision_de_fin_annee: "Admis",
      observation: "Remarquable",
      trimestre: 3,
    },
    {
      id: "4",
      eleve_id: "4",
      decision_de_fin_annee: "Redoublants",
      observation: "Doit s'améliorer",
      trimestre: 3,
    },
    {
      id: "5",
      eleve_id: "5",
      decision_de_fin_annee: "Admis",
      observation: "Très bien",
      trimestre: 3,
    },
    {
      id: "6",
      eleve_id: "6",
      decision_de_fin_annee: "Redoublants",
      observation: "Difficultés persistantes",
      trimestre: 3,
    },
  ];

  const sallesByClass = {
    "9af": [{ value: "salle1", label: "Salle A" }],
    "8af": [{ value: "salle2", label: "Salle B" }],
    "7af": [{ value: "salle3", label: "Salle C" }],
    "6af": [{ value: "salle4", label: "Salle D" }],
  };

  // Fonction pour obtenir la décision et observation d'un élève
  const getStudentDecision = (eleveId: string) => {
    const studentNotes = mockNotes.filter((note) => note.eleve_id === eleveId);
    const latestNote = studentNotes.reduce((latest, note) => {
      return note.trimestre > (latest?.trimestre || 0) ? note : latest;
    }, null);

    return {
      decision: latestNote?.decision_de_fin_annee || "Non définie",
      observation: latestNote?.observation || "",
    };
  };

  // Fonction pour obtenir le rapport complet d'un étudiant
  const getStudentReport = (eleve: any) => {
    const balance = getStudentBalance(eleve.id);
    const moyenneT1 = calculateMoyenneGeneraleTrimestre(eleve.id, 1);
    const moyenneT2 = calculateMoyenneGeneraleTrimestre(eleve.id, 2);
    const moyenneT3 = calculateMoyenneGeneraleTrimestre(eleve.id, 3);
    const moyenneAnnuelle = calculateMoyenneGeneraleAnnuelle(eleve.id);
    const { decision, observation } = getStudentDecision(eleve.id);

    return {
      ...eleve,
      moyenneT1,
      moyenneT2,
      moyenneT3,
      moyenneAnnuelle,
      decision_de_fin_annee: decision,
      observation,
      fraisScolarite: balance.totalDu,
      fraisPayes: balance.totalPaye,
      solde: balance.solde,
    };
  };

  // Données des rapports
  const studentsReport = useMemo(
    () => mockEleves.map(getStudentReport),
    [mockEleves]
  );

  // Statistiques basées sur les décisions de fin d'année
  const totalStudents = studentsReport.length;
  const admisStudents = studentsReport.filter(
    (s) => s.decision_de_fin_annee === "Admis"
  ).length;
  const redoublantsStudents = studentsReport.filter(
    (s) => s.decision_de_fin_annee === "Redoublants"
  ).length;
  const expulseStudents = studentsReport.filter(
    (s) => s.decision_de_fin_annee === "Expulser"
  ).length;

  // Filtrage des étudiants
  const filteredStudents = studentsReport.filter((student) => {
    if (filterClasse !== "toutes" && student.classe_id !== filterClasse)
      return false;
    if (
      filterDecision !== "tous" &&
      student.decision_de_fin_annee !== filterDecision
    )
      return false;
    return true;
  });

  // Moyennes par classe
  const moyennesParClasse = useMemo(() => {
    const classeStats = {};

    studentsReport.forEach((student) => {
      const classeId = student.classe_id;
      const classe = mockClasses.find((c) => c.value === classeId);
      const classeName = classe?.label || "Inconnue";

      if (!classeStats[classeName]) {
        classeStats[classeName] = {
          nom: classeName,
          eleves: [],
          moyenneClasse: 0,
          top3: [],
        };
      }

      if (student.moyenneAnnuelle && student.moyenneAnnuelle > 0) {
        classeStats[classeName].eleves.push(student);
      }
    });

    // Calculer les moyennes et top 3 pour chaque classe
    Object.values(classeStats).forEach((classe) => {
      if (classe.eleves.length > 0) {
        classe.moyenneClasse =
          classe.eleves.reduce((sum, e) => sum + (e.moyenneAnnuelle || 0), 0) /
          classe.eleves.length;
        classe.top3 = classe.eleves
          .sort((a, b) => (b.moyenneAnnuelle || 0) - (a.moyenneAnnuelle || 0))
          .slice(0, 3);
      }
    });

    return classeStats;
  }, [studentsReport]);

  // Moyenne générale de l'école
  const moyenneGeneraleEcole = useMemo(() => {
    const elevesAvecMoyenne = studentsReport.filter(
      (s) => s.moyenneAnnuelle && s.moyenneAnnuelle > 0
    );
    if (elevesAvecMoyenne.length === 0) return 0;
    return (
      elevesAvecMoyenne.reduce((sum, e) => sum + (e.moyenneAnnuelle || 0), 0) /
      elevesAvecMoyenne.length
    );
  }, [studentsReport]);

  // Lauréat des lauréats
  const laureatDesLaureats = useMemo(() => {
    return studentsReport
      .filter((s) => s.moyenneAnnuelle && s.moyenneAnnuelle > 0)
      .sort((a, b) => (b.moyenneAnnuelle || 0) - (a.moyenneAnnuelle || 0))[0];
  }, [studentsReport]);

  const StatCard = ({ title, value, icon: Icon, color, subtitle, onClick }) => (
    <div
      className={`p-6 rounded-lg border transition-all cursor-pointer hover:scale-105 ${
        darkMode
          ? "bg-gray-800 border-gray-700 hover:bg-gray-750"
          : "bg-white border-gray-200 hover:bg-gray-50"
      }`}
      onClick={onClick}
    >
      <div className="flex items-center justify-between">
        <div>
          <p
            className={`text-sm font-medium ${
              darkMode ? "text-gray-400" : "text-gray-600"
            }`}
          >
            {title}
          </p>
          <p
            className={`text-2xl font-bold ${
              darkMode ? "text-white" : "text-gray-900"
            }`}
          >
            {value}
          </p>
          {subtitle && (
            <p
              className={`text-xs ${
                darkMode ? "text-gray-500" : "text-gray-500"
              }`}
            >
              {subtitle}
            </p>
          )}
        </div>
        <div className={`p-3 rounded-full ${color}`}>
          <Icon className="h-6 w-6 text-white" />
        </div>
      </div>
    </div>
  );

  const LaureatCard = ({ student, rank, isLaureatDesLaureats = false }) => (
    <div
      className={`p-4 rounded-lg border-2 ${
        isLaureatDesLaureats
          ? "border-purple-500 bg-gradient-to-r from-purple-100 to-pink-100"
          : "border-yellow-400 bg-yellow-50"
      } ${darkMode && !isLaureatDesLaureats ? "bg-gray-800" : ""}`}
    >
      <div className="flex items-center justify-between">
        <div className="flex items-center space-x-3">
          <div
            className={`w-10 h-10 rounded-full flex items-center justify-center ${
              isLaureatDesLaureats
                ? "bg-gradient-to-r from-purple-500 to-pink-500"
                : rank === 1
                ? "bg-yellow-500"
                : rank === 2
                ? "bg-gray-400"
                : "bg-yellow-600"
            }`}
          >
            {isLaureatDesLaureats ? (
              <Trophy className="h-6 w-6 text-white" />
            ) : (
              <span className="text-white font-bold">{rank}</span>
            )}
          </div>
          <div>
            <h4
              className={`font-bold ${
                darkMode ? "text-white" : "text-gray-900"
              }`}
            >
              {student.prenom} {student.nom}
              {isLaureatDesLaureats && (
                <span className="ml-2 text-purple-600 font-bold text-sm">
                  LAURÉAT DES LAURÉATS
                </span>
              )}
            </h4>
            <p
              className={`text-sm ${
                darkMode ? "text-gray-400" : "text-gray-600"
              }`}
            >
              {mockClasses.find((c) => c.value === student.classe_id)?.label ||
                "Inconnue"}{" "}
              - Salle{" "}
              {sallesByClass[student.classe_id]?.[0]?.label || "Inconnue"}
            </p>
            <p
              className={`text-xs ${
                darkMode ? "text-gray-500" : "text-gray-500"
              }`}
            >
              {student.decision_de_fin_annee} - {student.observation}
            </p>
          </div>
        </div>
        <div className="text-right">
          <p
            className={`text-2xl font-bold ${
              isLaureatDesLaureats
                ? "text-purple-600"
                : darkMode
                ? "text-yellow-400"
                : "text-yellow-600"
            }`}
          >
            {student.moyenneAnnuelle?.toFixed(2) || "N/A"}/20
          </p>
          <div className="flex space-x-1">
            <p className="text-xs text-gray-500">
              T1: {student.moyenneT1?.toFixed(1) || "N/A"}
            </p>
            <p className="text-xs text-gray-500">
              T2: {student.moyenneT2?.toFixed(1) || "N/A"}
            </p>
            <p className="text-xs text-gray-500">
              T3: {student.moyenneT3?.toFixed(1) || "N/A"}
            </p>
          </div>
        </div>
      </div>
    </div>
  );

  const ClasseStatsCard = ({ classe, stats }) => (
    <div
      className={`p-6 rounded-lg border ${
        darkMode ? "bg-gray-800 border-gray-700" : "bg-white border-gray-200"
      }`}
    >
      <div className="flex items-center justify-between mb-4">
        <h4
          className={`font-bold text-lg ${
            darkMode ? "text-white" : "text-gray-900"
          }`}
        >
          {classe}
        </h4>
        <div className="text-right">
          <p
            className={`text-xl font-bold ${
              stats.moyenneClasse >= 15
                ? "text-green-600"
                : stats.moyenneClasse >= 12
                ? "text-yellow-600"
                : "text-red-600"
            }`}
          >
            {stats.moyenneClasse.toFixed(2)}/20
          </p>
          <p
            className={`text-xs ${
              darkMode ? "text-gray-400" : "text-gray-600"
            }`}
          >
            Moyenne de classe
          </p>
        </div>
      </div>

      <div className="space-y-3">
        <h5 className="font-medium text-sm text-blue-600">
          Top 3 de la classe
        </h5>
        {stats.top3.map((student, index) => (
          <div
            key={student.id}
            className={`flex items-center justify-between p-3 rounded-lg ${
              darkMode ? "bg-gray-700" : "bg-gray-50"
            }`}
          >
            <div className="flex items-center space-x-3">
              <div
                className={`w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${
                  index === 0
                    ? "bg-yellow-500 text-white"
                    : index === 1
                    ? "bg-gray-400 text-white"
                    : "bg-yellow-600 text-white"
                }`}
              >
                {index + 1}
              </div>
              <div>
                <p
                  className={`font-medium text-sm ${
                    darkMode ? "text-white" : "text-gray-900"
                  }`}
                >
                  {student.prenom} {student.nom}
                </p>
                <p
                  className={`text-xs ${
                    darkMode ? "text-gray-400" : "text-gray-600"
                  }`}
                >
                  {student.decision_de_fin_annee}
                </p>
              </div>
            </div>
            <span className="font-bold text-blue-600">
              {student.moyenneAnnuelle?.toFixed(2)}/20
            </span>
          </div>
        ))}
      </div>
    </div>
  );

  return (
    <div
      className={`min-h-screen transition-colors duration-300 ${
        darkMode ? "bg-gray-900 text-white" : "bg-gray-50 text-gray-900"
      }`}
    >
      {/* Header */}
      <header
        className={`p-6 border-b transition-colors ${
          darkMode ? "bg-gray-800 border-gray-700" : "bg-white border-gray-200"
        }`}
      >
        <div className="max-w-7xl mx-auto flex justify-between items-center">
          <div className="flex items-center space-x-4">
            <BarChart3 className="h-8 w-8 text-blue-600" />
            <div>
              <h1 className="text-2xl font-bold">
                Tableau de Bord - Année Scolaire {selectedYear}
              </h1>
              <p
                className={`text-sm ${
                  darkMode ? "text-gray-400" : "text-gray-600"
                }`}
              >
                Section Élèves et Résultats - Version Améliorée
              </p>
            </div>
          </div>

          <div className="flex items-center space-x-4">
            <button
              onClick={() => setShowFilters(!showFilters)}
              className={`flex items-center space-x-2 px-4 py-2 rounded-lg transition-colors ${
                darkMode
                  ? "bg-gray-700 hover:bg-gray-600"
                  : "bg-gray-200 hover:bg-gray-300"
              }`}
            >
              <Filter className="h-4 w-4" />
              <span>Filtres</span>
            </button>

            <button
              onClick={() => window.print()}
              className={`flex items-center space-x-2 px-4 py-2 rounded-lg transition-colors ${
                darkMode
                  ? "bg-gray-700 hover:bg-gray-600"
                  : "bg-gray-200 hover:bg-gray-300"
              }`}
            >
              <Printer className="h-4 w-4" />
              <span>Imprimer</span>
            </button>
          </div>
        </div>
      </header>

      <main className="max-w-7xl mx-auto p-6">
        {/* Filtres */}
        {showFilters && (
          <div
            className={`mb-6 p-4 rounded-lg ${
              darkMode ? "bg-gray-800" : "bg-gray-100"
            }`}
          >
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <label className="block text-sm font-medium mb-2">Classe</label>
                <select
                  value={filterClasse}
                  onChange={(e) => setFilterClasse(e.target.value)}
                  className={`w-full p-2 border rounded-lg ${
                    darkMode
                      ? "bg-gray-800 border-gray-600 text-white"
                      : "bg-white border-gray-300"
                  }`}
                >
                  <option value="toutes">Toutes les classes</option>
                  {mockClasses.map((classe) => (
                    <option key={classe.value} value={classe.value}>
                      {classe.label}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="block text-sm font-medium mb-2">
                  Décision de fin d'année
                </label>
                <select
                  value={filterDecision}
                  onChange={(e) => setFilterDecision(e.target.value)}
                  className={`w-full p-2 border rounded-lg ${
                    darkMode
                      ? "bg-gray-800 border-gray-600 text-white"
                      : "bg-white border-gray-300"
                  }`}
                >
                  <option value="tous">Toutes les décisions</option>
                  <option value="Admis">Admis</option>
                  <option value="Redoublants">Redoublants</option>
                  <option value="Expulser">Expulsés</option>
                </select>
              </div>
              <div className="flex items-end">
                <button
                  onClick={() => {
                    setFilterClasse("toutes");
                    setFilterDecision("tous");
                  }}
                  className="w-full bg-blue-600 text-white p-2 rounded-lg hover:bg-blue-700 transition-colors"
                >
                  Réinitialiser
                </button>
              </div>
            </div>
          </div>
        )}

        {/* Section Élèves & Résultats */}
        <div className="space-y-8">
          {/* Statistiques générales */}
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <StatCard
              title="Total Élèves"
              value={totalStudents}
              icon={Users}
              color="bg-blue-500"
              subtitle="Tous statuts confondus"
            />
            <StatCard
              title="Admis"
              value={admisStudents}
              icon={CheckCircle}
              color="bg-green-500"
              subtitle={`${((admisStudents / totalStudents) * 100).toFixed(
                1
              )}% du total`}
            />
            <StatCard
              title="Redoublants"
              value={redoublantsStudents}
              icon={BookOpen}
              color="bg-yellow-500"
              subtitle={`${(
                (redoublantsStudents / totalStudents) *
                100
              ).toFixed(1)}% du total`}
            />
            <StatCard
              title="Expulsés"
              value={expulseStudents}
              icon={XCircle}
              color="bg-red-600"
              subtitle={`${((expulseStudents / totalStudents) * 100).toFixed(
                1
              )}% du total`}
            />
          </div>

          {/* Moyenne générale de l'école */}
          <div
            className={`p-6 rounded-lg border text-center ${
              darkMode
                ? "bg-gray-800 border-gray-700"
                : "bg-white border-gray-200"
            }`}
          >
            <Target className="h-12 w-12 text-purple-600 mx-auto mb-3" />
            <h3 className="text-2xl font-bold text-purple-600 mb-2">
              Moyenne Générale de l'École
            </h3>
            <p className="text-4xl font-bold text-purple-600 mb-2">
              {moyenneGeneraleEcole.toFixed(2)}/20
            </p>
            <p
              className={`text-sm ${
                darkMode ? "text-gray-400" : "text-gray-600"
              }`}
            >
              Basée sur{" "}
              {
                studentsReport.filter(
                  (s) => s.moyenneAnnuelle && s.moyenneAnnuelle > 0
                ).length
              }{" "}
              élèves évalués
            </p>
          </div>

          {/* Lauréat des lauréats */}
          {laureatDesLaureats && (
            <div
              className={`p-6 rounded-lg border ${
                darkMode
                  ? "bg-gray-800 border-gray-700"
                  : "bg-white border-gray-200"
              }`}
            >
              <h3 className="text-lg font-semibold mb-4 text-center text-purple-600">
                LAURÉAT DES LAURÉATS
              </h3>
              <LaureatCard
                student={laureatDesLaureats}
                rank={1}
                isLaureatDesLaureats={true}
              />
            </div>
          )}

          {/* Top 3 par classe */}
          <div
            className={`p-6 rounded-lg border ${
              darkMode
                ? "bg-gray-800 border-gray-700"
                : "bg-white border-gray-200"
            }`}
          >
            <h3 className="text-lg font-semibold mb-6">
              Moyennes et Lauréats par Classe
            </h3>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {Object.entries(moyennesParClasse).map(([classe, stats]) => (
                <ClasseStatsCard key={classe} classe={classe} stats={stats} />
              ))}
            </div>
          </div>

          {/* Liste filtrée des étudiants si filtres appliqués */}
          {(filterClasse !== "toutes" || filterDecision !== "tous") && (
            <div
              className={`p-6 rounded-lg border ${
                darkMode
                  ? "bg-gray-800 border-gray-700"
                  : "bg-white border-gray-200"
              }`}
            >
              <h3 className="text-lg font-semibold mb-4">
                Étudiants filtrés ({filteredStudents.length})
              </h3>
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {filteredStudents.map((student) => (
                  <div
                    key={student.id}
                    className={`p-4 rounded-lg border ${
                      darkMode
                        ? "bg-gray-700 border-gray-600"
                        : "bg-gray-50 border-gray-200"
                    }`}
                  >
                    <div className="flex justify-between items-start">
                      <div>
                        <h4
                          className={`font-medium ${
                            darkMode ? "text-white" : "text-gray-900"
                          }`}
                        >
                          {student.prenom} {student.nom}
                        </h4>
                        <p
                          className={`text-sm ${
                            darkMode ? "text-gray-400" : "text-gray-600"
                          }`}
                        >
                          {mockClasses.find(
                            (c) => c.value === student.classe_id
                          )?.label || "Inconnue"}
                        </p>
                        <p
                          className={`text-xs ${
                            student.decision_de_fin_annee === "Admis"
                              ? "text-green-600"
                              : student.decision_de_fin_annee === "Redoublants"
                              ? "text-yellow-600"
                              : "text-red-600"
                          }`}
                        >
                          {student.decision_de_fin_annee}
                        </p>
                        <p
                          className={`text-xs ${
                            darkMode ? "text-gray-500" : "text-gray-500"
                          }`}
                        >
                          {student.observation}
                        </p>
                      </div>
                      <div className="text-right">
                        <span className="font-bold text-blue-600 text-lg">
                          {student.moyenneAnnuelle?.toFixed(2) || "N/A"}/20
                        </span>
                        <div className="text-xs space-y-1">
                          <div>
                            T1: {student.moyenneT1?.toFixed(1) || "N/A"}
                          </div>
                          <div>
                            T2: {student.moyenneT2?.toFixed(1) || "N/A"}
                          </div>
                          <div>
                            T3: {student.moyenneT3?.toFixed(1) || "N/A"}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </main>

      {/* Footer avec informations supplémentaires */}
      <footer
        className={`mt-12 p-6 border-t ${
          darkMode ? "bg-gray-800 border-gray-700" : "bg-white border-gray-200"
        }`}
      >
        <div className="max-w-7xl mx-auto">
          <div className="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
              <h3
                className={`font-semibold mb-3 ${
                  darkMode ? "text-white" : "text-gray-900"
                }`}
              >
                Résumé Exécutif
              </h3>
              <div className="space-y-2">
                <p
                  className={`text-sm ${
                    darkMode ? "text-gray-400" : "text-gray-600"
                  }`}
                >
                  Taux d'admission:{" "}
                  {((admisStudents / totalStudents) * 100).toFixed(1)}%
                </p>
                <p
                  className={`text-sm ${
                    darkMode ? "text-gray-400" : "text-gray-600"
                  }`}
                >
                  Moyenne générale: {moyenneGeneraleEcole.toFixed(2)}/20
                </p>
                <p
                  className={`text-sm ${
                    darkMode ? "text-gray-400" : "text-gray-600"
                  }`}
                >
                  Effectif: {totalStudents} élèves dans{" "}
                  {Object.keys(moyennesParClasse).length} classes
                </p>
              </div>
            </div>

            <div>
              <h3
                className={`font-semibold mb-3 ${
                  darkMode ? "text-white" : "text-gray-900"
                }`}
              >
                Actions Recommandées
              </h3>
              <div className="space-y-2">
                <p
                  className={`text-sm ${
                    darkMode ? "text-gray-400" : "text-gray-600"
                  }`}
                >
                  Soutien pour les {redoublantsStudents} redoublants
                </p>
                <p
                  className={`text-sm ${
                    darkMode ? "text-gray-400" : "text-gray-600"
                  }`}
                >
                  Reconnaissance des {admisStudents} élèves admis
                </p>
                <p
                  className={`text-sm ${
                    darkMode ? "text-gray-400" : "text-gray-600"
                  }`}
                >
                  Révision des cas d'expulsion
                </p>
              </div>
            </div>

            <div>
              <h3
                className={`font-semibold mb-3 ${
                  darkMode ? "text-white" : "text-gray-900"
                }`}
              >
                Informations Système
              </h3>
              <div className="space-y-2">
                <p
                  className={`text-sm ${
                    darkMode ? "text-gray-400" : "text-gray-600"
                  }`}
                >
                  Dernière mise à jour: {new Date().toLocaleDateString("fr-FR")}
                </p>
                <p
                  className={`text-sm ${
                    darkMode ? "text-gray-400" : "text-gray-600"
                  }`}
                >
                  Données actualisées en temps réel
                </p>
                <p
                  className={`text-sm ${
                    darkMode ? "text-gray-400" : "text-gray-600"
                  }`}
                >
                  Rapport généré automatiquement
                </p>
              </div>
            </div>
          </div>

          <div
            className={`mt-6 pt-6 border-t text-center ${
              darkMode
                ? "border-gray-700 text-gray-400"
                : "border-gray-200 text-gray-600"
            }`}
          >
            <p className="text-sm">
              © {new Date().getFullYear()} Système de Gestion Scolaire - Tous
              droits réservés
            </p>
          </div>
        </div>
      </footer>
    </div>
  );
};

export default Rapport;
